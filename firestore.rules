rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Global Primitives & Access Control Helpers
    // -------------------------------------------------------------
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'koceirmehdi@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Authorized if demo enterprise, platform administrator, or tenant owner
    function isAuthorizedBusiness(businessId) {
      return businessId == 'main_enterprise' || (
        isSignedIn() && (
          isAdmin() ||
          request.auth.uid == businessId
        )
      );
    }

    // -------------------------------------------------------------
    // Health & Connectivity Check Collection
    // -------------------------------------------------------------
    match /test/{docId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // Administrators Registry
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // -------------------------------------------------------------
    // Multi-Tenant Business & E-Commerce Data Fortress
    // -------------------------------------------------------------
    match /businesses/{businessId} {
      allow read, write: if isAuthorizedBusiness(businessId);

      // Orders Subcollection (Bordereaux de livraison & transactions)
      match /orders/{orderId} {
        allow read, write: if isAuthorizedBusiness(businessId);
      }

      // Products Catalog & Inventory
      match /products/{productId} {
        allow read, write: if isAuthorizedBusiness(businessId);
      }

      // Stock Traceability & Audit Logs
      match /stockMovements/{movementId} {
        allow read, write: if isAuthorizedBusiness(businessId);
      }

      // Customers CRM (Algerian PII Protected)
      match /customers/{customerId} {
        allow read, write: if isAuthorizedBusiness(businessId);
      }

      // Delivery Drivers Fleet
      match /drivers/{driverId} {
        allow read, write: if isAuthorizedBusiness(businessId);
      }
    }

    // Default-deny catch-all for any other arbitrary collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
